<section class="editorial-statement color-{{ section.settings.color_scheme }}">
  <div class="grid-container">
  <div class="grid-item-left">
        {% if section.settings.eyebrow != blank %}
      <p class="editorial-eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}
        <h2 class="editorial-heading">
      {{ section.settings.heading | newline_to_br }}
    </h2>
  </div>
  <div class="grid-item-right">
    {% if section.settings.text != blank %}
      <div class="editorial-text rte">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a
        href="{{ section.settings.button_link }}"
        class="button button--secondary editorial-button"
      >
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</div>
</section>

<style>
.grid-container {
  display: flex;
  grid-template-columns: 1fr 1fr; 
  gap: 20px;    
  align-items: center;  
  justify-content: center; 
  margin: 0 auto;
  padding: 0;
  max-width: 1200px;
                
}

.grid-item-right, .grid-item-left {
    padding: 0 30px 0 0;
}

.grid-item-right{
    padding: 0 0 0 30px;
}

.editorial-statement {
    background: #ffffff;
    padding: 0;
}

.editorial-statement .page-width {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
}

.editorial-eyebrow {
    font-size: 12px;
    letter-spacing: .25em;
    text-transform: uppercase;
    color: #777;
    margin-bottom: 30px;
}

.editorial-heading {
    font-size: clamp(54px, 60px, 92px);
    line-height: .95;
    letter-spacing: -.05em;
    margin: 0;
    font-weight: 700;
}

.editorial-text {
    max-width: 520px;
    font-size: 20px;
    line-height: 1.8;
    color: #444;
}

.editorial-button {
    margin-top: 40px;
    width: fit-content;
}

@media screen and (max-width: 768px) {
    .grid-container {
        display: grid;
        grid-template-columns: 1fr; 
        gap: 15px;            
    }

    .grid-item-right, .grid-item-left {
    padding: 30px 0 0 30px;
}

    .editorial-statement .page-width {
        grid-template-columns: 1fr;
        gap: 60px;
    }

    .editorial-heading {
        font-size: 48px;
    }

    .editorial-text {
        font-size: 18px;
    }
}

</style>

{% schema %}
{
  "name":"Editorial Statement",
  "tag":"section",
  "class":"section",
  "settings":[

    {
      "type":"color_scheme",
      "id":"color_scheme",
      "label":"Color scheme",
      "default":"scheme-1"
    },

    {
      "type":"text",
      "id":"eyebrow",
      "label":"Eyebrow",
      "default":"OUR PHILOSOPHY"
    },

    {
      "type":"textarea",
      "id":"heading",
      "label":"Heading",
      "default":"EVERY MILE.\nEVERY CLIMB.\nEVERY RIDE.\nEVERY ROUND.\nEVERY WORKOUT."
    },

    {
      "type":"richtext",
      "id":"text",
      "label":"Text",
      "default":"<p>Your skin is there too.</p><p>Stride Skin exists to help active people recover from sweat, sun, wind, and environmental stress.</p>"
    },

    {
      "type":"text",
      "id":"button_label",
      "label":"Button label",
      "default":"Our Philosophy"
    },

    {
      "type":"url",
      "id":"button_link",
      "label":"Button link"
    }

  ],
  "presets":[
    {
      "name":"Editorial Statement"
    }
  ]
}
{% endschema %}