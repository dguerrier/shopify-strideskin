<section class="lifestyle-experience">
  <div class="lifestyle-experience__image">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          class: 'lifestyle-experience__img'
      }}
    {% endif %}
  </div>

  <div class="lifestyle-experience__overlay"></div>

  <div class="lifestyle-experience__content">
    {% if section.settings.eyebrow != blank %}
      <p class="lifestyle-experience__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="lifestyle-experience__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="lifestyle-experience__text">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a
        href="{{ section.settings.button_link }}"
        class="lifestyle-experience__button"
      >
        {{ section.settings.button_label }} →
      </a>
    {% endif %}
  </div>
</section>

<style>
  .lifestyle-experience {
    position: relative;
    width: 100%;
    min-height: 720px;
    overflow: hidden;
  }

  .lifestyle-experience__image {
    position: absolute;
    inset: 0;
  }

  .lifestyle-experience__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lifestyle-experience__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.62) 0%,
      rgba(0, 0, 0, 0.32) 45%,
      rgba(0, 0, 0, 0.05) 75%
    );
  }

  .lifestyle-experience__content {
    position: relative;
    z-index: 2;
    min-height: 720px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 100px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    color: #ffffff;
  }

  .lifestyle-experience__eyebrow {
    margin: 0 0 24px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .lifestyle-experience__heading {
    max-width: 650px;
    margin: 0 0 30px;
    font-size: clamp(48px, 6vw, 88px);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-weight: 700;
  }

  .lifestyle-experience__text {
    max-width: 480px;
    margin-bottom: 30px;
    font-size: 18px;
    line-height: 1.7;
  }

  .lifestyle-experience__button {
    color: #ffffff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-bottom: 1px solid #ffffff;
    padding-bottom: 8px;
  }

  @media screen and (max-width: 749px) {
    .lifestyle-experience {
      min-height: 650px;
    }

    .lifestyle-experience__content {
      min-height: 650px;
      padding: 60px 25px;
      justify-content: flex-end;
      padding-bottom: 70px;
    }

    .lifestyle-experience__heading {
      font-size: 48px;
    }

    .lifestyle-experience__text {
      font-size: 16px;
    }

    .lifestyle-experience__overlay {
      background: linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.68) 0%,
        rgba(0, 0, 0, 0.25) 60%,
        rgba(0, 0, 0, 0.05) 100%
      );
    }
  }
</style>

{% schema %}
{
  "name": "Lifestyle Experience",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE STRIDE LIFESTYLE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BUILT FOR PEOPLE WHO MOVE."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>For people who spend more time outside than inside.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "EXPLORE LIFESTYLE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Lifestyle Experience"
    }
  ]
}
{% endschema %}