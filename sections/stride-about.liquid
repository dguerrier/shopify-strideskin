<div
  id="StrideAbout-{{ section.id }}"
  class="stride-about"
>
  {% for block in section.blocks %}

    {% case block.type %}

      {% when 'hero' %}

        <section
          class="stride-about__hero"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            <div class="stride-about__hero-media">
              {{
                block.settings.image
                | image_url: width: 2400
                | image_tag:
                  widths: '750, 1100, 1500, 2000, 2400',
                  sizes: '100vw',
                  loading: 'eager',
                  preload: true,
                  class: 'stride-about__hero-image'
              }}
            </div>
          {% endif %}

          <div
            class="stride-about__hero-overlay"
            style="--stride-about-overlay: {{ block.settings.overlay_opacity | divided_by: 100.0 }};"
          ></div>

          <div class="stride-about__hero-content stride-about__hero-content--{{ block.settings.text_alignment }}">
            {% if block.settings.eyebrow != blank %}
              <div class="stride-about__eyebrow">
                {{ block.settings.eyebrow }}
              </div>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h1 class="stride-about__hero-heading">
                {{ block.settings.heading }}
              </h1>
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="stride-about__hero-description">
                {{ block.settings.description | newline_to_br }}
              </div>
            {% endif %}

            {% if block.settings.button_label != blank and block.settings.button_link != blank %}
              <a
                href="{{ block.settings.button_link }}"
                class="stride-about__button stride-about__button--light"
              >
                {{ block.settings.button_label }}
              </a>
            {% endif %}
          </div>
        </section>


      {% when 'text_image' %}

        <section
          class="
            stride-about__text-image
            stride-about__text-image--{{ block.settings.image_position }}
          "
          {{ block.shopify_attributes }}
        >
          <div class="stride-about__text-image-inner">

            <div class="stride-about__text-image-copy">

              {% if block.settings.eyebrow != blank %}
                <div class="stride-about__eyebrow stride-about__eyebrow--dark">
                  {{ block.settings.eyebrow }}
                </div>
              {% endif %}

              {% if block.settings.heading != blank %}
                <h2 class="stride-about__heading">
                  {{ block.settings.heading }}
                </h2>
              {% endif %}

              {% if block.settings.body != blank %}
                <div class="stride-about__body">
                  {{ block.settings.body | newline_to_br }}
                </div>
              {% endif %}

            </div>

            {% if block.settings.image != blank %}
              <div class="stride-about__text-image-media">
                {{
                  block.settings.image
                  | image_url: width: 1600
                  | image_tag:
                    widths: '550, 800, 1100, 1400, 1600',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    loading: 'lazy',
                    class: 'stride-about__image'
                }}
              </div>
            {% endif %}

          </div>
        </section>


      {% when 'approach' %}

        <section
          class="stride-about__approach"
          {{ block.shopify_attributes }}
        >
          <div class="stride-about__container">

            <div class="stride-about__section-intro">

              {% if block.settings.eyebrow != blank %}
                <div class="stride-about__eyebrow stride-about__eyebrow--dark">
                  {{ block.settings.eyebrow }}
                </div>
              {% endif %}

              {% if block.settings.heading != blank %}
                <h2 class="stride-about__heading">
                  {{ block.settings.heading }}
                </h2>
              {% endif %}

              {% if block.settings.body != blank %}
                <div class="stride-about__body stride-about__body--wide">
                  {{ block.settings.body | newline_to_br }}
                </div>
              {% endif %}

            </div>

            <div class="stride-about__pillars">

              <div class="stride-about__pillar">
                <div class="stride-about__pillar-title">
                  {{ block.settings.reset_title }}
                </div>

                <div class="stride-about__pillar-body">
                  {{ block.settings.reset_body }}
                </div>
              </div>

              <div class="stride-about__pillar">
                <div class="stride-about__pillar-title">
                  {{ block.settings.repair_title }}
                </div>

                <div class="stride-about__pillar-body">
                  {{ block.settings.repair_body }}
                </div>
              </div>

              <div class="stride-about__pillar">
                <div class="stride-about__pillar-title">
                  {{ block.settings.recover_title }}
                </div>

                <div class="stride-about__pillar-body">
                  {{ block.settings.recover_body }}
                </div>
              </div>

            </div>

            {% if block.settings.closing != blank %}
              <div class="stride-about__approach-closing">
                {{ block.settings.closing }}
              </div>
            {% endif %}

            {% if block.settings.button_label != blank and block.settings.button_link != blank %}
              <a
                href="{{ block.settings.button_link }}"
                class="stride-about__button stride-about__button--dark"
              >
                {{ block.settings.button_label }}
              </a>
            {% endif %}

          </div>
        </section>


      {% when 'lifestyle' %}

        <section
          class="stride-about__lifestyle"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.image != blank %}
            <div class="stride-about__lifestyle-media">
              {{
                block.settings.image
                | image_url: width: 2200
                | image_tag:
                  widths: '750, 1100, 1500, 1800, 2200',
                  sizes: '100vw',
                  loading: 'lazy',
                  class: 'stride-about__lifestyle-image'
              }}
            </div>
          {% endif %}

          <div class="stride-about__lifestyle-copy">

            {% if block.settings.eyebrow != blank %}
              <div class="stride-about__eyebrow stride-about__eyebrow--dark">
                {{ block.settings.eyebrow }}
              </div>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2 class="stride-about__heading">
                {{ block.settings.heading }}
              </h2>
            {% endif %}

            {% if block.settings.body != blank %}
              <div class="stride-about__body">
                {{ block.settings.body | newline_to_br }}
              </div>
            {% endif %}

          </div>

        </section>


      {% when 'beliefs' %}

        <section
          class="stride-about__beliefs"
          {{ block.shopify_attributes }}
        >
          <div class="stride-about__container">

            {% if block.settings.eyebrow != blank %}
              <div class="stride-about__eyebrow stride-about__eyebrow--dark">
                {{ block.settings.eyebrow }}
              </div>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2 class="stride-about__heading">
                {{ block.settings.heading }}
              </h2>
            {% endif %}

            <div class="stride-about__belief-grid">

              <div class="stride-about__belief">
                <div class="stride-about__belief-title">
                  {{ block.settings.belief_1_title }}
                </div>
                <div class="stride-about__belief-body">
                  {{ block.settings.belief_1_body }}
                </div>
              </div>

              <div class="stride-about__belief">
                <div class="stride-about__belief-title">
                  {{ block.settings.belief_2_title }}
                </div>
                <div class="stride-about__belief-body">
                  {{ block.settings.belief_2_body }}
                </div>
              </div>

              <div class="stride-about__belief">
                <div class="stride-about__belief-title">
                  {{ block.settings.belief_3_title }}
                </div>
                <div class="stride-about__belief-body">
                  {{ block.settings.belief_3_body }}
                </div>
              </div>

              <div class="stride-about__belief">
                <div class="stride-about__belief-title">
                  {{ block.settings.belief_4_title }}
                </div>
                <div class="stride-about__belief-body">
                  {{ block.settings.belief_4_body }}
                </div>
              </div>

            </div>

          </div>
        </section>


      {% when 'ingredients' %}

        <section
          class="stride-about__ingredients"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.image != blank %}
            <div class="stride-about__ingredients-media">
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  widths: '550, 800, 1100, 1400',
                  sizes: '(min-width: 990px) 30vw, 100vw',
                  loading: 'lazy',
                  class: 'stride-about__ingredients-image'
              }}
            </div>
          {% endif %}

          <div class="stride-about__ingredients-content">

            {% if block.settings.eyebrow != blank %}
              <div class="stride-about__eyebrow stride-about__eyebrow--dark">
                {{ block.settings.eyebrow }}
              </div>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2 class="stride-about__heading">
                {{ block.settings.heading }}
              </h2>
            {% endif %}

            {% if block.settings.intro != blank %}
              <div class="stride-about__body">
                {{ block.settings.intro | newline_to_br }}
              </div>
            {% endif %}

            <div class="stride-about__ingredient-grid">

              <div class="stride-about__ingredient">
                <div class="stride-about__ingredient-name">
                  {{ block.settings.ingredient_1_name }}
                </div>
                <div class="stride-about__ingredient-body">
                  {{ block.settings.ingredient_1_body }}
                </div>
              </div>

              <div class="stride-about__ingredient">
                <div class="stride-about__ingredient-name">
                  {{ block.settings.ingredient_2_name }}
                </div>
                <div class="stride-about__ingredient-body">
                  {{ block.settings.ingredient_2_body }}
                </div>
              </div>

              <div class="stride-about__ingredient">
                <div class="stride-about__ingredient-name">
                  {{ block.settings.ingredient_3_name }}
                </div>
                <div class="stride-about__ingredient-body">
                  {{ block.settings.ingredient_3_body }}
                </div>
              </div>

              <div class="stride-about__ingredient">
                <div class="stride-about__ingredient-name">
                  {{ block.settings.ingredient_4_name }}
                </div>
                <div class="stride-about__ingredient-body">
                  {{ block.settings.ingredient_4_body }}
                </div>
              </div>

              <div class="stride-about__ingredient">
                <div class="stride-about__ingredient-name">
                  {{ block.settings.ingredient_5_name }}
                </div>
                <div class="stride-about__ingredient-body">
                  {{ block.settings.ingredient_5_body }}
                </div>
              </div>

            </div>

            {% if block.settings.closing != blank %}
              <div class="stride-about__ingredients-closing">
                {{ block.settings.closing }}
              </div>
            {% endif %}

          </div>

        </section>


      {% when 'system' %}

        <section
          class="stride-about__system"
          {{ block.shopify_attributes }}
        >
          <div class="stride-about__container">

            {% if block.settings.eyebrow != blank %}
              <div class="stride-about__eyebrow stride-about__eyebrow--dark">
                {{ block.settings.eyebrow }}
              </div>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2 class="stride-about__heading">
                {{ block.settings.heading }}
              </h2>
            {% endif %}

            <div class="stride-about__system-grid">

              <div class="stride-about__system-card">
                {% if block.settings.reset_image != blank %}
                  <div class="stride-about__system-media">
                    {{
                      block.settings.reset_image
                      | image_url: width: 1000
                      | image_tag:
                        widths: '400, 600, 800, 1000',
                        sizes: '(min-width: 990px) 33vw, 100vw',
                        loading: 'lazy',
                        class: 'stride-about__system-image'
                    }}
                  </div>
                {% endif %}

                <div class="stride-about__system-copy">
                  <div class="stride-about__system-title">
                    {{ block.settings.reset_title }}
                  </div>

                  <div class="stride-about__system-heading">
                    {{ block.settings.reset_heading }}
                  </div>

                  <div class="stride-about__system-body">
                    {{ block.settings.reset_body }}
                  </div>

                  {% if block.settings.reset_link != blank %}
                    <a
                      href="{{ block.settings.reset_link }}"
                      class="stride-about__text-link"
                    >
                      {{ block.settings.reset_label }}
                    </a>
                  {% endif %}
                </div>
              </div>


              <div class="stride-about__system-card">
                {% if block.settings.repair_image != blank %}
                  <div class="stride-about__system-media">
                    {{
                      block.settings.repair_image
                      | image_url: width: 1000
                      | image_tag:
                        widths: '400, 600, 800, 1000',
                        sizes: '(min-width: 990px) 33vw, 100vw',
                        loading: 'lazy',
                        class: 'stride-about__system-image'
                    }}
                  </div>
                {% endif %}

                <div class="stride-about__system-copy">
                  <div class="stride-about__system-title">
                    {{ block.settings.repair_title }}
                  </div>

                  <div class="stride-about__system-heading">
                    {{ block.settings.repair_heading }}
                  </div>

                  <div class="stride-about__system-body">
                    {{ block.settings.repair_body }}
                  </div>

                  {% if block.settings.repair_link != blank %}
                    <a
                      href="{{ block.settings.repair_link }}"
                      class="stride-about__text-link"
                    >
                      {{ block.settings.repair_label }}
                    </a>
                  {% endif %}
                </div>
              </div>


              <div class="stride-about__system-card">
                {% if block.settings.recover_image != blank %}
                  <div class="stride-about__system-media">
                    {{
                      block.settings.recover_image
                      | image_url: width: 1000
                      | image_tag:
                        widths: '400, 600, 800, 1000',
                        sizes: '(min-width: 990px) 33vw, 100vw',
                        loading: 'lazy',
                        class: 'stride-about__system-image'
                    }}
                  </div>
                {% endif %}

                <div class="stride-about__system-copy">
                  <div class="stride-about__system-title">
                    {{ block.settings.recover_title }}
                  </div>

                  <div class="stride-about__system-heading">
                    {{ block.settings.recover_heading }}
                  </div>

                  <div class="stride-about__system-body">
                    {{ block.settings.recover_body }}
                  </div>

                  {% if block.settings.recover_link != blank %}
                    <a
                      href="{{ block.settings.recover_link }}"
                      class="stride-about__text-link"
                    >
                      {{ block.settings.recover_label }}
                    </a>
                  {% endif %}
                </div>
              </div>

            </div>

          </div>
        </section>


      {% when 'closing' %}

        <section
          class="stride-about__closing"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.image != blank %}
            <div class="stride-about__closing-media">
              {{
                block.settings.image
                | image_url: width: 2400
                | image_tag:
                  widths: '750, 1100, 1500, 2000, 2400',
                  sizes: '100vw',
                  loading: 'lazy',
                  class: 'stride-about__closing-image'
              }}
            </div>
          {% endif %}

          <div class="stride-about__closing-overlay"></div>

          <div class="stride-about__closing-content">

            {% if block.settings.heading != blank %}
              <h2 class="stride-about__closing-heading">
                {{ block.settings.heading }}
              </h2>
            {% endif %}

            {% if block.settings.body != blank %}
              <div class="stride-about__closing-body">
                {{ block.settings.body }}
              </div>
            {% endif %}

            {% if block.settings.button_label != blank and block.settings.button_link != blank %}
              <a
                href="{{ block.settings.button_link }}"
                class="stride-about__button stride-about__button--light"
              >
                {{ block.settings.button_label }}
              </a>
            {% endif %}

          </div>

        </section>

    {% endcase %}

  {% endfor %}
</div>


<style>
#StrideAbout-{{ section.id }} {
  --stride-about-bg: #f8f7f4;
  --stride-about-text: #171717;
  --stride-about-muted: #5d5d5d;
  --stride-about-border: rgba(23, 23, 23, 0.14);
  --stride-about-white: #ffffff;

  background: var(--stride-about-bg);
  color: var(--stride-about-text);

  overflow: hidden;
}

#StrideAbout-{{ section.id }} * {
  box-sizing: border-box;
}

#StrideAbout-{{ section.id }} img {
  display: block;
  max-width: 100%;
}


/* --------------------------------
   SHARED
-------------------------------- */

#StrideAbout-{{ section.id }} .stride-about__container {
  width: min(1400px, calc(100% - 100px));
  margin: 0 auto;
}

#StrideAbout-{{ section.id }} .stride-about__eyebrow {
  font-family: var(--font-body-family);
  font-size: 10px;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 0.17em;
  text-transform: uppercase;
}

#StrideAbout-{{ section.id }} .stride-about__eyebrow--dark {
  color: var(--stride-about-muted);
}

#StrideAbout-{{ section.id }} .stride-about__heading {
  margin: 12px 0 0;

  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(34px, 4vw, 58px);
  font-weight: 400;
  line-height: 0.98;
  letter-spacing: -0.035em;
}

#StrideAbout-{{ section.id }} .stride-about__body {
  max-width: 570px;
  margin-top: 24px;

  font-family: var(--font-body-family);
  font-size: 15px;
  line-height: 1.7;
  color: var(--stride-about-muted);
}

#StrideAbout-{{ section.id }} .stride-about__body--wide {
  max-width: 760px;
}

#StrideAbout-{{ section.id }} .stride-about__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 42px;
  padding: 0 20px;

  font-family: var(--font-body-family);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.14em;
  line-height: 1;
  text-transform: uppercase;

  text-decoration: none;

  border: 1px solid transparent;

  transition:
    background-color 0.25s ease,
    color 0.25s ease,
    border-color 0.25s ease;
}

#StrideAbout-{{ section.id }} .stride-about__button--light {
  color: #ffffff;
  border-color: rgba(255,255,255,0.8);
  background: transparent;
}

#StrideAbout-{{ section.id }} .stride-about__button--light:hover {
  color: #111111;
  background: #ffffff;
  border-color: #ffffff;
}

#StrideAbout-{{ section.id }} .stride-about__button--dark {
  color: #ffffff;
  border-color: #171717;
  background: #171717;
}

#StrideAbout-{{ section.id }} .stride-about__button--dark:hover {
  color: #171717;
  background: transparent;
}


/* --------------------------------
   HERO
-------------------------------- */

#StrideAbout-{{ section.id }} .stride-about__hero {
  position: relative;

  min-height: {{ section.settings.hero_height }}px;

  display: flex;
  align-items: center;

  overflow: hidden;

  color: #ffffff;
  background: #222222;
}

#StrideAbout-{{ section.id }} .stride-about__hero-media,
#StrideAbout-{{ section.id }} .stride-about__hero-overlay {
  position: absolute;
  inset: 0;
}

#StrideAbout-{{ section.id }} .stride-about__hero-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

#StrideAbout-{{ section.id }} .stride-about__hero-overlay {
  background: rgba(0, 0, 0, var(--stride-about-overlay));
}

#StrideAbout-{{ section.id }} .stride-about__hero-content {
  position: relative;
  z-index: 2;

  width: min(1400px, calc(100% - 100px));
  margin: 0 auto;

  padding: 90px 0;
}

#StrideAbout-{{ section.id }} .stride-about__hero-content--left {
  text-align: left;
}

#StrideAbout-{{ section.id }} .stride-about__hero-content--center {
  text-align: center;
}

#StrideAbout-{{ section.id }} .stride-about__hero-content--right {
  text-align: right;
}

#StrideAbout-{{ section.id }} .stride-about__hero-content--left .stride-about__button {
  margin-top: 30px;
}

#StrideAbout-{{ section.id }} .stride-about__hero-content--center .stride-about__button,
#StrideAbout-{{ section.id }} .stride-about__hero-content--right .stride-about__button {
  margin-top: 30px;
}

#StrideAbout-{{ section.id }} .stride-about__hero-heading {
  max-width: 760px;
  margin: 12px 0 0;

  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(52px, 7vw, 100px);
  font-weight: 400;
  line-height: 0.9;
  letter-spacing: -0.055em;

  color: #ffffff;
}

#StrideAbout-{{ section.id }} .stride-about__hero-content--center .stride-about__hero-heading {
  margin-left: auto;
  margin-right: auto;
}

#StrideAbout-{{ section.id }} .stride-about__hero-content--right .stride-about__hero-heading {
  margin-left: auto;
}

#StrideAbout-{{ section.id }} .stride-about__hero-description {
  max-width: 560px;
  margin-top: 24px;

  font-family: var(--font-body-family);
  font-size: 15px;
  line-height: 1.65;

  color: rgba(255,255,255,0.92);
}

#StrideAbout-{{ section.id }} .stride-about__hero-content--center .stride-about__hero-description {
  margin-left: auto;
  margin-right: auto;
}

#StrideAbout-{{ section.id }} .stride-about__hero-content--right .stride-about__hero-description {
  margin-left: auto;
}


/* --------------------------------
   TEXT + IMAGE
-------------------------------- */

#StrideAbout-{{ section.id }} .stride-about__text-image {
  padding: 100px 0;
  background: var(--stride-about-bg);
}

#StrideAbout-{{ section.id }} .stride-about__text-image-inner {
  width: min(1400px, calc(100% - 100px));
  margin: 0 auto;

  display: grid;
  grid-template-columns: 1fr 1fr;

  gap: 80px;

  align-items: center;
}

#StrideAbout-{{ section.id }} .stride-about__text-image--image-left
.stride-about__text-image-copy {
  order: 2;
}

#StrideAbout-{{ section.id }} .stride-about__text-image--image-left
.stride-about__text-image-media {
  order: 1;
}

#StrideAbout-{{ section.id }} .stride-about__text-image-media {
  overflow: hidden;
}

#StrideAbout-{{ section.id }} .stride-about__image {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
}


/* --------------------------------
   APPROACH
-------------------------------- */

#StrideAbout-{{ section.id }} .stride-about__approach {
  padding: 105px 0;
  background: #ffffff;
}

#StrideAbout-{{ section.id }} .stride-about__pillars {
  display: grid;
  grid-template-columns: repeat(3, 1fr);

  margin-top: 65px;

  border-top: 1px solid var(--stride-about-border);
  border-bottom: 1px solid var(--stride-about-border);
}

#StrideAbout-{{ section.id }} .stride-about__pillar {
  padding: 32px 35px 35px 0;
}

#StrideAbout-{{ section.id }} .stride-about__pillar + .stride-about__pillar {
  padding-left: 35px;
  border-left: 1px solid var(--stride-about-border);
}

#StrideAbout-{{ section.id }} .stride-about__pillar-title {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 26px;
  line-height: 1;
}

#StrideAbout-{{ section.id }} .stride-about__pillar-body {
  margin-top: 12px;

  color: var(--stride-about-muted);

  font-family: var(--font-body-family);
  font-size: 13px;
  line-height: 1.55;
}

#StrideAbout-{{ section.id }} .stride-about__approach-closing {
  margin-top: 25px;

  font-family: var(--font-body-family);
  font-size: 13px;
  color: var(--stride-about-muted);
}

#StrideAbout-{{ section.id }} .stride-about__approach .stride-about__button {
  margin-top: 24px;
}


/* --------------------------------
   LIFESTYLE
-------------------------------- */

#StrideAbout-{{ section.id }} .stride-about__lifestyle {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;

  background: var(--stride-about-bg);
}

