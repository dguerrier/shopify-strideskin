        {
          "type": "text",
          "id": "text",
          "label": "Shipping text",
          "default": "Free shipping on orders over $75."
        }
      ]
    },

    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "THE DETAILS"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }

  ],

  "presets": [
    {
      "name": "Stride Bundle Hero",
      "category": "Stride Skin",
      "blocks": [
        {
          "type": "eyebrow"
        },
        {
          "type": "title"
        },
        {
          "type": "price"
        },
        {
          "type": "description"
        },
        {
          "type": "included_summary"
        },
        {
          "type": "bundle_product"
        },
        {
          "type": "bundle_product"
        },
        {
          "type": "bundle_product"
        },
        {
          "type": "bundle_product"
        },
        {
          "type": "bundle_product"
        },
        {
          "type": "quantity"
        },
        {
          "type": "buy_buttons"
        },
        {
          "type": "shipping"
        },
        {
          "type": "accordion"
        }
      ]
