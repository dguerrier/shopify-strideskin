<div
  id="StrideBundleHero-{{ section.id }}"
  class="stride-bundle"
>
  <div class="stride-bundle__inner">

    <!-- MEDIA -->

    <div class="stride-bundle__media">

      {% if product.media.size > 0 %}

        <div class="stride-bundle__gallery">

          {% for media in product.media %}

            <div
              class="
                stride-bundle__media-item
                {% unless forloop.first %}stride-bundle__media-item--secondary{% endunless %}
              "
            >

              {% if media.media_type == 'image' %}

                {{
                  media
                  | image_url: width: 1800
                  | image_tag:
                    widths: '600, 900, 1200, 1500, 1800',
                    sizes: '(min-width: 990px) 58vw, 100vw',
                    loading: 'lazy',
                    class: 'stride-bundle__image'
                }}

              {% elsif media.media_type == 'video' %}

                {{
                  media
                  | video_tag:
                    autoplay: true,
                    loop: true,
                    muted: true,
                    controls: false,
                    class: 'stride-bundle__video'
                }}

              {% endif %}

            </div>

          {% endfor %}

        </div>

      {% else %}

        <div class="stride-bundle__placeholder">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>

      {% endif %}

    </div>


    <!-- PRODUCT INFORMATION -->

    <div class="stride-bundle__info">

      <div class="stride-bundle__info-inner">

        {% for block in section.blocks %}

          {% case block.type %}


            {% when 'eyebrow' %}

              <div
                class="stride-bundle__eyebrow"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.text }}
              </div>


            {% when 'title' %}

              <h1
                class="stride-bundle__title"
                {{ block.shopify_attributes }}
              >
                {{ product.title }}
              </h1>


            {% when 'price' %}

              {% assign bundle_variant = product.selected_or_first_available_variant %}

              <div
                class="stride-bundle__price"
                {{ block.shopify_attributes }}
              >
                <span class="stride-bundle__price-current">
                  {{ bundle_variant.price | money }}
                </span>

                {% if bundle_variant.compare_at_price != blank and bundle_variant.compare_at_price > bundle_variant.price %}
                  <span class="stride-bundle__price-compare">
                    {{ bundle_variant.compare_at_price | money }}
                  </span>
                {% endif %}
              </div>


            {% when 'description' %}

              {% if block.settings.text != blank %}

                <div
                  class="stride-bundle__description"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.text }}
                </div>

              {% elsif product.description != blank %}

                <div
                  class="stride-bundle__description"
                  {{ block.shopify_attributes }}
                >
                  {{ product.description }}
                </div>

              {% endif %}


            {% when 'included_summary' %}

              <div
                class="stride-bundle__included-summary"
                {{ block.shopify_attributes }}
              >

                <div class="stride-bundle__included-label">
                  {{ block.settings.heading }}
                </div>

                <div class="stride-bundle__included-count">
                  {{ section.blocks | where: 'type', 'bundle_product' | size }}
                  products
                </div>

              </div>


            {% when 'bundle_product' %}

              {% assign included_product = block.settings.product %}

              {% if included_product != blank %}

                <div
                  class="stride-bundle__included-item"
                  {{ block.shopify_attributes }}
                >

                  <div class="stride-bundle__included-image">

                    {% if included_product.featured_image != blank %}

                      {{
                        included_product.featured_image
                        | image_url: width: 300
                        | image_tag:
                          widths: '120, 180, 240, 300',
                          sizes: '100px',
                          loading: 'lazy'
                      }}

                    {% endif %}

                  </div>

                  <div class="stride-bundle__included-details">

                    <div class="stride-bundle__included-system">
                      {{ block.settings.system }}
                    </div>

                    <div class="stride-bundle__included-title">
                      {{ included_product.title }}
                    </div>

                    {% if block.settings.description != blank %}
                      <div class="stride-bundle__included-description">
                        {{ block.settings.description }}
                      </div>
                    {% endif %}

                  </div>

                </div>

              {% endif %}


            {% when 'variant_picker' %}

              {% unless product.has_only_default_variant %}

                <div
                  class="stride-bundle__variant"
                  {{ block.shopify_attributes }}
                >

                  {% for option in product.options_with_values %}

                    <div class="stride-bundle__option">

                      <label
                        for="Option-{{ section.id }}-{{ forloop.index0 }}"
                        class="stride-bundle__option-label"
                      >
                        {{ option.name }}
                      </label>

                      <select
                        id="Option-{{ section.id }}-{{ forloop.index0 }}"
                        class="stride-bundle__select"
                        name="options[{{ option.name | escape }}]"
                      >

                        {% for value in option.values %}

                          <option value="{{ value | escape }}">
                            {{ value }}
                          </option>

                        {% endfor %}

                      </select>

                    </div>

                  {% endfor %}

                </div>

              {% endunless %}


            {% when 'quantity' %}

              <div
                class="stride-bundle__quantity"
                {{ block.shopify_attributes }}
              >

                <label
                  for="Quantity-{{ section.id }}"
                  class="stride-bundle__option-label"
                >
                  Quantity
                </label>

                <input
                  id="Quantity-{{ section.id }}"
                  type="number"
                  name="quantity"
                  min="1"
                  value="1"
                  form="BundleProductForm-{{ section.id }}"
                >

              </div>


            {% when 'buy_buttons' %}

              {% assign bundle_form_id = 'BundleProductForm-' | append: section.id %}

              <div
                class="stride-bundle__purchase"
                {{ block.shopify_attributes }}
              >

                {% form 'product',
                  product,
                  id: bundle_form_id,
                  class: 'stride-bundle__form'
                %}

                  <input
                    type="hidden"
                    name="id"
                    value="{{ product.selected_or_first_available_variant.id }}"
                  >

                  <button
                    type="submit"
                    name="add"
                    class="stride-bundle__add"
                    {% unless product.selected_or_first_available_variant.available %}
                      disabled
                    {% endunless %}
                  >

                    {% if product.selected_or_first_available_variant.available %}
                      {{ block.settings.button_label }}
                    {% else %}
                      SOLD OUT
                    {% endif %}

                  </button>

                {% endform %}

              </div>


            {% when '@app' %}

              <div
                class="stride-bundle__app-block"
                {{ block.shopify_attributes }}
              >
                {% render block %}
              </div>


            {% when 'shipping' %}

              {% if block.settings.text != blank %}

                <div
                  class="stride-bundle__shipping"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.text }}
                </div>

              {% endif %}


            {% when 'accordion' %}

              <details
                class="stride-bundle__accordion"
                {{ block.shopify_attributes }}
              >

                <summary>
                  {{ block.settings.heading }}

                  <span>+</span>
                </summary>

                <div class="stride-bundle__accordion-content">

                  {% if block.settings.content != blank %}
                    {{ block.settings.content }}
                  {% else %}
                    {{ product.description }}
                  {% endif %}

                </div>

              </details>

          {% endcase %}

        {% endfor %}

      </div>

    </div>

  </div>
</div>


<style>

#StrideBundleHero-{{ section.id }} {

  --bundle-text: #171717;
  --bundle-muted: #666666;
  --bundle-border: rgba(23, 23, 23, 0.14);
  --bundle-background: #f8f7f4;

  background: var(--bundle-background);
  color: var(--bundle-text);

}


/* --------------------------------
   MAIN LAYOUT
-------------------------------- */

#StrideBundleHero-{{ section.id }}
.stride-bundle__inner {

  display: grid;

  grid-template-columns:
    1.15fr
    0.85fr;

  max-width: 1600px;

  margin: 0 auto;

}


/* --------------------------------
   MEDIA
-------------------------------- */

#StrideBundleHero-{{ section.id }}
.stride-bundle__media {

  position: relative;

  min-width: 0;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__gallery {

  display: grid;

  grid-template-columns:
    1fr
    1fr;

  gap: 2px;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__media-item {

  position: relative;

  overflow: hidden;

  background: #eeeeee;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__media-item:first-child {

  grid-column: 1 / -1;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__image,
#StrideBundleHero-{{ section.id }}
.stride-bundle__video {

  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

}


/* --------------------------------
   INFORMATION
-------------------------------- */

#StrideBundleHero-{{ section.id }}
.stride-bundle__info {

  position: relative;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__info-inner {

  position: sticky;

  top: 0;

  padding: 90px 60px;

}


/* --------------------------------
   TYPOGRAPHY
-------------------------------- */

#StrideBundleHero-{{ section.id }}
.stride-bundle__eyebrow {

  margin-bottom: 14px;

  font-family: var(--font-body-family);

  font-size: 10px;
  font-weight: 600;

  letter-spacing: 0.16em;

  line-height: 1.4;

  text-transform: uppercase;

  color: var(--bundle-muted);

}


#StrideBundleHero-{{ section.id }}
.stride-bundle__title {

  max-width: 650px;

  margin: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: clamp(42px, 4vw, 68px);

  font-weight: 400;

  line-height: 0.95;

  letter-spacing: -0.045em;

}


#StrideBundleHero-{{ section.id }}
.stride-bundle__price {

  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;

  margin-top: 24px;

  font-family: var(--font-body-family);
  font-size: 15px;

  color: var(--bundle-text);

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__price-current {

  font-weight: 500;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__price-compare {

  opacity: 0.45;
  text-decoration: line-through;

}


#StrideBundleHero-{{ section.id }}
.stride-bundle__description {

  max-width: 500px;

  margin-top: 28px;

  font-family: var(--font-body-family);

  font-size: 14px;

  line-height: 1.65;

  color: var(--bundle-muted);

}


/* --------------------------------
   INCLUDED SUMMARY
-------------------------------- */

#StrideBundleHero-{{ section.id }}
.stride-bundle__included-summary {

  display: flex;

  align-items: baseline;

  justify-content: space-between;

  margin-top: 45px;

  padding-bottom: 12px;

  border-bottom: 1px solid var(--bundle-border);

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__included-label {

  font-family: var(--font-body-family);

  font-size: 10px;
  font-weight: 600;

  letter-spacing: 0.13em;

  text-transform: uppercase;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__included-count {

  font-family: var(--font-body-family);

  font-size: 11px;

  color: var(--bundle-muted);

}


/* --------------------------------
   INCLUDED PRODUCTS
-------------------------------- */

#StrideBundleHero-{{ section.id }}
.stride-bundle__included-item {

  display: flex;

  gap: 16px;

  padding: 15px 0;

  border-bottom: 1px solid var(--bundle-border);

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__included-image {

  flex: 0 0 70px;

  width: 70px;
  height: 70px;

  overflow: hidden;

  background: #eeeeee;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__included-image img {

  width: 100%;
  height: 100%;

  object-fit: cover;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__included-details {

  padding-top: 3px;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__included-system {

  font-size: 9px;
  font-weight: 600;

  letter-spacing: 0.12em;

  text-transform: uppercase;

  color: var(--bundle-muted);

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__included-title {

  margin-top: 5px;

  font-family: Georgia, "Times New Roman", serif;

  font-size: 18px;

  line-height: 1.1;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__included-description {

  margin-top: 6px;

  font-size: 12px;

  line-height: 1.45;

  color: var(--bundle-muted);

}


/* --------------------------------
   OPTIONS
-------------------------------- */

#StrideBundleHero-{{ section.id }}
.stride-bundle__variant {

  margin-top: 30px;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__option {

  margin-bottom: 15px;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__option-label {

  display: block;

  margin-bottom: 7px;

  font-size: 10px;

  font-weight: 600;

  letter-spacing: 0.12em;

  text-transform: uppercase;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__select,
#StrideBundleHero-{{ section.id }}
.stride-bundle__quantity input {

  width: 100%;

  min-height: 42px;

  padding: 0 12px;

  border: 1px solid var(--bundle-border);

  border-radius: 0;

  background: transparent;

  font-family: var(--font-body-family);

  font-size: 13px;

}


/* --------------------------------
   QUANTITY
-------------------------------- */

#StrideBundleHero-{{ section.id }}
.stride-bundle__quantity {

  margin-top: 20px;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__quantity input {

  width: 80px;

}


/* --------------------------------
   ADD TO CART
-------------------------------- */

#StrideBundleHero-{{ section.id }}
.stride-bundle__purchase {

  margin-top: 25px;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__add {

  width: 100%;

  min-height: 52px;

  border: 1px solid #171717;

  border-radius: 0;

  background: #171717;

  color: #ffffff;

  cursor: pointer;

  font-family: var(--font-body-family);

  font-size: 10px;
  font-weight: 600;

  letter-spacing: 0.14em;

  text-transform: uppercase;

  transition:
    background-color 0.25s ease,
    color 0.25s ease;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__add:hover {

  background: transparent;

  color: #171717;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__add:disabled {

  opacity: 0.5;

  cursor: not-allowed;

}


/* --------------------------------
   SHIPPING
-------------------------------- */

#StrideBundleHero-{{ section.id }}
.stride-bundle__app-block {

  margin-top: 24px;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__shipping {

  margin-top: 14px;

  font-size: 11px;

  line-height: 1.5;

  color: var(--bundle-muted);

}


/* --------------------------------
   ACCORDIONS
-------------------------------- */

#StrideBundleHero-{{ section.id }}
.stride-bundle__accordion {

  margin-top: 30px;

  border-top: 1px solid var(--bundle-border);

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__accordion:last-child {

  border-bottom: 1px solid var(--bundle-border);

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__accordion summary {

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 17px 0;

  cursor: pointer;

  list-style: none;

  font-size: 10px;
  font-weight: 600;

  letter-spacing: 0.13em;

  text-transform: uppercase;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__accordion summary::-webkit-details-marker {

  display: none;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__accordion summary span {

  font-size: 16px;

  font-weight: 400;

}

#StrideBundleHero-{{ section.id }}
.stride-bundle__accordion-content {

  padding: 0 0 20px;

  font-size: 13px;

  line-height: 1.6;

  color: var(--bundle-muted);

}


/* --------------------------------
   MOBILE
-------------------------------- */

@media screen and (max-width: 989px) {

  #StrideBundleHero-{{ section.id }}
  .stride-bundle__inner {

    grid-template-columns: 1fr;

  }

  #StrideBundleHero-{{ section.id }}
  .stride-bundle__info-inner {

    position: relative;

    padding: 55px 30px 70px;

  }

}


@media screen and (max-width: 749px) {

  #StrideBundleHero-{{ section.id }}
  .stride-bundle__gallery {

    display: block;

  }

  /*
    Keep the first image prominent on mobile.
    Secondary media is hidden to keep the PDP
    experience clean.
  */

  #StrideBundleHero-{{ section.id }}
  .stride-bundle__media-item:not(:first-child) {

    display: none;

  }

  #StrideBundleHero-{{ section.id }}
  .stride-bundle__media-item:first-child {

    aspect-ratio: 1 / 1;

  }

  #StrideBundleHero-{{ section.id }}
  .stride-bundle__info-inner {

    padding: 45px 20px 60px;

  }

  #StrideBundleHero-{{ section.id }}
  .stride-bundle__title {

    font-size: 48px;

  }

}

</style>


