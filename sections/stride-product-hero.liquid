<section class="stride-product-hero">

  <div class="stride-product-hero__inner">

    <!-- PRODUCT MEDIA -->

    <div class="stride-product-hero__media">

      {% if product.media.size > 0 %}

        <div class="stride-product-hero__gallery">

          {% for media in product.media %}

            <div class="stride-product-hero__media-item">

              {% case media.media_type %}

                {% when 'image' %}

                  {{
                    media
                    | image_url: width: 1800
                    | image_tag:
                      loading: 'lazy',
                      widths: '600, 900, 1200, 1500, 1800',
                      sizes: '(min-width: 990px) 55vw, 100vw',
                      class: 'stride-product-hero__image'
                  }}

                {% when 'video' %}

                  {{
                    media
                    | video_tag:
                      autoplay: false,
                      loop: true,
                      muted: true,
                      controls: true,
                      class: 'stride-product-hero__video'
                  }}

                {% when 'external_video' %}

                  {{ media | external_video_tag }}

              {% endcase %}

            </div>

          {% endfor %}

        </div>

      {% else %}

        <div class="stride-product-hero__media-placeholder">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>

      {% endif %}

    </div>


    <!-- PRODUCT INFORMATION -->

    <div class="stride-product-hero__info">

      <div class="stride-product-hero__info-inner">

        {% if section.settings.eyebrow != blank %}
          <div class="stride-product-hero__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}


        <h1 class="stride-product-hero__title">
          {{ product.title }}
        </h1>


        <div class="stride-product-hero__price">

          {% if product.compare_at_price > product.price %}

            <span class="stride-product-hero__price-current">
              {{ product.price | money }}
            </span>

            <span class="stride-product-hero__price-compare">
              {{ product.compare_at_price | money }}
            </span>

          {% else %}

            <span class="stride-product-hero__price-current">
              {{ product.price | money }}
            </span>

          {% endif %}

        </div>


        {% if section.settings.short_description != blank %}

          <div class="stride-product-hero__description">
            {{ section.settings.short_description }}
          </div>

        {% endif %}


        {% form 'product', product, id: 'StrideProductForm', class: 'stride-product-hero__form' %}

          {% unless product.has_only_default_variant %}

            <div class="stride-product-hero__variants">

              {% for option in product.options_with_values %}

                <div class="stride-product-hero__option">

                  <label class="stride-product-hero__option-label">
                    {{ option.name }}
                  </label>

                  <select
                    name="options[{{ option.name | escape }}]"
                    class="stride-product-hero__select"
                  >

                    {% for value in option.values %}

                      <option
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}
                          selected
                        {% endif %}
                      >
                        {{ value }}
                      </option>

                    {% endfor %}

                  </select>

                </div>

              {% endfor %}

            </div>

          {% endunless %}


          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
          >


          <!-- QUANTITY -->

          <div class="stride-product-hero__purchase-row">

            <div class="stride-product-hero__quantity">

              <button
                type="button"
                class="stride-product-hero__quantity-button"
                data-quantity-minus
                aria-label="Decrease quantity"
              >
                −
              </button>

              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                class="stride-product-hero__quantity-input"
                aria-label="Quantity"
              >

              <button
                type="button"
                class="stride-product-hero__quantity-button"
                data-quantity-plus
                aria-label="Increase quantity"
              >
                +
              </button>

            </div>


            <!-- ADD TO CART -->

            <button
              type="submit"
              name="add"
              class="stride-product-hero__add"
              {% unless product.selected_or_first_available_variant.available %}
                disabled
              {% endunless %}
            >

              {% if product.selected_or_first_available_variant.available %}
                {{ section.settings.add_to_cart_label }}
              {% else %}
                SOLD OUT
              {% endif %}

            </button>

          </div>


          {% if product.selected_or_first_available_variant.available %}

            <div class="stride-product-hero__shipping">
              {{ section.settings.shipping_message }}
            </div>

          {% endif %}

        {% endform %}


        <!-- ACCORDIONS -->

        <div class="stride-product-hero__accordions">

          {% if section.settings.why_it_works != blank %}

            <details class="stride-product-hero__accordion">

              <summary>
                <span>WHY IT WORKS</span>
                <span class="stride-product-hero__accordion-icon">+</span>
              </summary>

              <div class="stride-product-hero__accordion-content">
                {{ section.settings.why_it_works }}
              </div>

            </details>

          {% endif %}


          {% if section.settings.how_to_use != blank %}

            <details class="stride-product-hero__accordion">

              <summary>
                <span>HOW TO USE</span>
                <span class="stride-product-hero__accordion-icon">+</span>
              </summary>

              <div class="stride-product-hero__accordion-content">
                {{ section.settings.how_to_use }}
              </div>

            </details>

          {% endif %}


          {% if section.settings.ingredients != blank %}

            <details class="stride-product-hero__accordion">

              <summary>
                <span>INGREDIENTS</span>
                <span class="stride-product-hero__accordion-icon">+</span>
              </summary>

              <div class="stride-product-hero__accordion-content">
                {{ section.settings.ingredients }}
              </div>

            </details>

          {% endif %}

        </div>

      </div>

    </div>

  </div>

</section>


<style>

  .stride-product-hero {
    width: 100%;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }


  .stride-product-hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    max-width: 1600px;
    margin: 0 auto;
  }


  /* MEDIA */

  .stride-product-hero__media {
    min-width: 0;
  }

  .stride-product-hero__gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }

  .stride-product-hero__media-item {
    position: relative;
    overflow: hidden;
    background: #f1f0ed;
  }

  .stride-product-hero__media-item:first-child {
    grid-column: 1 / -1;
  }

  .stride-product-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 520px;
    object-fit: cover;
  }

  .stride-product-hero__media-item:not(:first-child) .stride-product-hero__image {
    min-height: 400px;
  }

  .stride-product-hero__video {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 520px;
    object-fit: cover;
  }

  .stride-product-hero__media-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 700px;
    background: #f1f0ed;
  }


  /* PRODUCT INFORMATION */

  .stride-product-hero__info {
    display: flex;
    align-items: flex-start;
    min-width: 0;
  }

  .stride-product-hero__info-inner {
    position: sticky;
    top: 30px;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    padding: 90px 60px;
  }


  /* TITLE */

  .stride-product-hero__eyebrow {
    margin-bottom: 20px;
    font-family: var(--font-body-family);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .stride-product-hero__title {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(42px, 4.5vw, 68px);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .stride-product-hero__price {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    font-family: var(--font-body-family);
    font-size: 15px;
  }

  .stride-product-hero__price-current {
    font-weight: 500;
  }

  .stride-product-hero__price-compare {
    opacity: 0.45;
    text-decoration: line-through;
  }


  /* DESCRIPTION */

  .stride-product-hero__description {
    max-width: 430px;
    margin-top: 30px;
    font-family: var(--font-body-family);
    font-size: 15px;
    line-height: 1.65;
    opacity: 0.72;
  }


  /* FORM */

  .stride-product-hero__form {
    margin-top: 40px;
  }


  /* VARIANTS */

  .stride-product-hero__variants {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 25px;
  }

  .stride-product-hero__option-label {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-body-family);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .stride-product-hero__select {
    width: 100%;
    height: 48px;
    padding: 0 15px;
    border: 1px solid rgba(0,0,0,0.18);
    border-radius: 0;
    background: transparent;
    color: inherit;
    font-family: var(--font-body-family);
    font-size: 13px;
  }


  /* PURCHASE */

  .stride-product-hero__purchase-row {
    display: grid;
    grid-template-columns: 105px 1fr;
    gap: 10px;
  }

  .stride-product-hero__quantity {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    border: 1px solid rgba(0,0,0,0.18);
  }

  .stride-product-hero__quantity-button {
    width: 32px;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-size: 18px;
  }

  .stride-product-hero__quantity-input {
    width: 35px;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: center;
    font-family: var(--font-body-family);
    font-size: 13px;
  }

  .stride-product-hero__quantity-input::-webkit-inner-spin-button,
  .stride-product-hero__quantity-input::-webkit-outer-spin-button {
    margin: 0;
    appearance: none;
  }

  .stride-product-hero__add {
    width: 100%;
    min-height: 52px;
    padding: 0 25px;
    border: 1px solid #111;
    background: #111;
    color: #fff;
    cursor: pointer;
    font-family: var(--font-body-family);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    transition: opacity 0.25s ease;
  }

  .stride-product-hero__add:hover {
    opacity: 0.8;
  }

  .stride-product-hero__add:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .stride-product-hero__shipping {
    margin-top: 15px;
    font-family: var(--font-body-family);
    font-size: 10px;
    letter-spacing: 0.04em;
    line-height: 1.5;
    opacity: 0.55;
  }


  /* ACCORDIONS */

  .stride-product-hero__accordions {
    margin-top: 55px;
    border-top: 1px solid rgba(0,0,0,0.15);
  }

  .stride-product-hero__accordion {
    border-bottom: 1px solid rgba(0,0,0,0.15);
  }

  .stride-product-hero__accordion summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 58px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-body-family);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
  }

  .stride-product-hero__accordion summary::-webkit-details-marker {
    display: none;
  }

  .stride-product-hero__accordion-icon {
    font-size: 18px;
    font-weight: 300;
    transition: transform 0.25s ease;
  }

  .stride-product-hero__accordion[open] .stride-product-hero__accordion-icon {
    transform: rotate(45deg);
  }

  .stride-product-hero__accordion-content {
    padding: 0 0 25px;
    font-family: var(--font-body-family);
    font-size: 13px;
    line-height: 1.7;
    opacity: 0.7;
  }


  /* TABLET */

  @media screen and (max-width: 989px) {

    .stride-product-hero__inner {
      grid-template-columns: 1fr;
    }

    .stride-product-hero__info-inner {
      position: static;
      max-width: 700px;
      padding: 70px 40px 90px;
    }

    .stride-product-hero__gallery {
      grid-template-columns: 1fr 1fr;
    }

  }


  /* MOBILE */

  @media screen and (max-width: 749px) {

    .stride-product-hero__gallery {
      display: block;
    }

    .stride-product-hero__media-item {
      margin-bottom: 2px;
    }

    .stride-product-hero__media-item:not(:first-child) {
      display: none;
    }

    .stride-product-hero__image {
      min-height: 500px;
      aspect-ratio: 4 / 5;
    }

    .stride-product-hero__info-inner {
      padding: 55px 20px 70px;
    }

    .stride-product-hero__title {
      font-size: clamp(42px, 13vw, 58px);
    }

    .stride-product-hero__description {
      font-size: 14px;
    }

    .stride-product-hero__purchase-row {
      grid-template-columns: 90px 1fr;
    }

  }

</style>


<script>

  document.addEventListener('DOMContentLoaded', function() {

    const form = document.querySelector(
  '#StrideProductForm'
);

    if (!form) return;

    const minusButton = form.querySelector('[data-quantity-minus]');
    const plusButton = form.querySelector('[data-quantity-plus]');
    const quantityInput = form.querySelector('.stride-product-hero__quantity-input');

    if (minusButton && quantityInput) {

      minusButton.addEventListener('click', function() {

        const currentValue = parseInt(quantityInput.value) || 1;

        if (currentValue > 1) {
          quantityInput.value = currentValue - 1;
        }

      });

    }

    if (plusButton && quantityInput) {

      plusButton.addEventListener('click', function() {

        const currentValue = parseInt(quantityInput.value) || 1;

        quantityInput.value = currentValue + 1;

      });

    }

  });

</script>


{% schema %}
{
  "name": "Stride Product Hero",
  "tag": "section",
  "class": "section-stride-product-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "STRIDE SKIN"
    },
    {
      "type": "textarea",
      "id": "short_description",
      "label": "Short description",
      "default": "Skin care designed for people who move."
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "ADD TO CART"
    },
    {
      "type": "text",
      "id": "shipping_message",
      "label": "Shipping message",
      "default": "Free shipping on orders over $75."
    },
    {
      "type": "richtext",
      "id": "why_it_works",
      "label": "Why it works",
      "default": "<p>Designed to support skin exposed to sweat, sun, wind, and everyday environmental stress.</p>"
    },
    {
      "type": "richtext",
      "id": "how_to_use",
      "label": "How to use",
      "default": "<p>Use consistently as part of your Stride Skin routine. Apply as directed and follow with hydration.</p>"
    },
    {
      "type": "richtext",
      "id": "ingredients",
      "label": "Ingredients",
      "default": "<p>Add your product's full ingredient list here.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f7f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Stride Product Hero"
    }
  ]
}
{% endschema %}