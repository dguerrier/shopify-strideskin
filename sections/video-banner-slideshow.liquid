{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'swiper-bundle.min.js' | asset_url | script_tag }}

<div class="swiper-{{section.id}}">
    <div class="swiper-wrapper">
         {%- for block in section.blocks -%}
            <div class="video-banner swiper-slide">
            {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'video-tag' }}
            {%- else -%}
                <p>Please select a video in the theme editor.</p>
            {%- endif -%}
            <div class="video-banner-text-overlay">
                {%- if block.settings.title != blank -%}
                <h2>{{ block.settings.title }}</h2>
                {%- endif -%}
                <div class="video-banner-buttons">    
                    {%- if block.settings.button_1 != empty and block.settings.label_1 != blank -%}
                        <a href="{{ block.settings.button_1 }}" class="swipe-button" >{{ block.settings.label_1 }}</a>
                    {%- endif -%}
                    {%- if block.settings.button_2 != empty and block.settings.label_2 != blank -%}
                        <a href="{{ block.settings.button_2 }}" class="swipe-button" >{{ block.settings.label_2 }}</a>
                    {%- endif -%}
                </div>
            </div>
        </div>

        {% endfor %}

            
    </div>
     <div class="swiper-navigation" style="z-index:200; position:relative; width: 50%; left: 50%; transform: translateX(-50%); display: inline-block; padding: 20px;" >
                <div class="swiper-button-prev" style="z-index: 100; height:5%; padding: 20px;"> 
                    <img src="{{ 'left-arrow-backup-2-svgrepo-com.svg' | asset_url }}" alt="Previous" style="height: 20px;"/>
                </div>
                <div class="swiper-pagination" style="background-color: transparent;"></div>
                <div class="swiper-button-next" style="z-index: 100; height:10%;padding: 20px; ">
                    <img src="{{ 'right-arrow-backup-2-svgrepo-com.svg' | asset_url }}" alt="Next" style="height: 20px;"/> 
                </div>
    </div>
</div>
    
<script>
const swiper = new Swiper('.swiper-{{section.id}}', {
    loop: true,
    navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
    },
    pagination: {
        el: '.swiper-pagination',
        clickable: true,
    },
});
</script>

{%- style -%}
  .swiper-{{section.id}} .swipe-button{
    text-decoration: none;
    padding: 5px 15px; 
    margin: 0;
    color: white;
    border: 1px solid white;
    border-radius: 0px;
    background-color: transparent;  
    font-family: Georgia, "Times New Roman", serif;
  }

  .swiper-{{section.id}} .video-banner-text-overlay {
    position: absolute;
    color: white;
    text-align: center;
    font-size: 1.5rem;
    padding: 0;
    margin: 50px;
    height: calc(30% - 10px);
    box-sizing: border-box; 
    display: flex;
    align-items: left;
    flex-direction: column;
   }

.swiper-{{section.id}} .video-banner {
  position: relative;
  margin: 0;
  padding: 0;
  overflow: hidden;
  display: flex;
  justify-content: end;
  align-items: left;
  flex-direction: column;
 }

.swiper-{{section.id}} .video-banner-text-overlay h2{
    color: white;
    font-size: 2.0rem;
  }

.swiper-{{section.id}} .video-banner-buttons {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 10px; 
    
}

.swiper-{{section.id}} .video-tag {
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: white;
  object-fit: cover;  /*Forces video to fill width/height without losing aspect ratio */

}

@media only screen and (max-width: 768px) {
  .swiper-{{section.id}} .swipe-button{
    padding: 0; !important;
    margin: 0 !important;
    color: white !important;
    border: 0 !important;
    border-radius: 0px !important;
    background-color: transparent !important;  
  }

  .swiper-{{section.id}} .video-banner-buttons{
    display: flex;
    justify-content: flex-start;
    font-size: 1.1rem;
    padding: 0px;
    margin: 0;
    text-decoration: underline;
  }

  .swiper-{{section.id}} .video-banner-text-overlay h2{
    font-size: 1.2rem;
    padding: 0px;
    margin: 0px;
    color: white;
  }

  .swiper-{{section.id}} .video-banner-text-overlay {
    position: absolute;
    text-align: center;
    padding: 5px;
    margin: 0;
    height: calc(33% - 10px);
    box-sizing: border-box;
    }
}
{%- endstyle -%}

{% schema %}
{
    "name": "Video Slider",
    "tag": "section",
    "class": "section",
    "disabled_on": {
    "groups": ["header", "footer"] 
    },
    "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
  ],
    "blocks": [
        {
            "type": "Slide",
            "name": "Slide",
            "settings": [
                {
                    "type": "video",
                    "id": "video",
                    "label": "Video",
                },{
                    "type": "text",
                    "id": "title",
                    "label": "Title"
                },{
                    "type": "text",
                    "id": "label_1",
                    "label": "Button Label 1"
                },{
                    "type": "url",
                    "id": "button_1",
                    "label": "Button 1"
                },{
                    "type": "text",
                    "id": "label_2",
                    "label": "Button Label 2"
                },
                {
                    "type": "url",
                    "id": "button_2",
                    "label": "Button 2"
                },
            ],
        }, {
        "type": "buttons",
        "name": "Buttons",
        "settings": [
            {
                "type": "text",
                "id": "label",
                "label": "Label"
            },
            {
                "type": "url",
                "id": "button_link",
                "label": "Button Link"
            },
        ]
    }
    ],
 "presets": [
        {
        "name": "Video Slider",
        "category": "Video"
        }
    ]   
}

{% endschema %}