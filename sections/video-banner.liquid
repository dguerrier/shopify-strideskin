<div class="video-banner">
  {%- if section.settings.video != blank -%}
    {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'video-tag' }}
  {%- else -%}
    <p>Please select a video in the theme editor.</p>
  {%- endif -%}

  <div class="video-banner-text-overlay">
    {%- if section.settings.title != blank -%}
    <h2 style="color: white; background-color: red;">{{ section.settings.title }}</h2>
    {%- endif -%}
    <div class="video-banner-buttons">    
        {%- for block in section.blocks -%}
            {%- if block.type == 'buttons' -%}
                <a href="{{ block.settings.button_link }}" class="button">{{ block.settings.label }}</a>
            {%- endif -%}
        {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
    "name": "Video Banner",
    "tag": "section",
    "class": "section",
    "disabled_on": {
    "groups": ["header", "footer"]
  },
    "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video",
    },{
      "type": "text",
      "id": "title",
      "label": "Title"
    },
  ],
  "blocks": [
    {
        "type": "buttons",
        "name": "Buttons",
        "settings": [
            {
                "type": "text",
                "id": "label",
                "label": "Label"
            },
            {
                "type": "url",
                "id": "button_link",
                "label": "Button Link"
            },
        ]
    }
  ],
    "presets": [
        {
        "name": "Video Banner",
        "category": "Video"
        }
    ]
}
{% endschema %}
